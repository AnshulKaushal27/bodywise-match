# apps/api .env.example
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,https://bodywise-match.vercel.app
RATE_LIMIT=100
DEBUG_TOKEN=optional_debug_token_for_production_diagnostics

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Optional Strategy B Groq LLM Intent Parser (falls back to Strategy A rules parser if omitted)
# Format: gsk_... (Never commit real keys. Add to apps/api/.env.local or apps/api/.env)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
LLM_ENABLED=true
LLM_TIMEOUT_MS=15000
LLM_MAX_INPUT_CHARS=1500
LLM_DAILY_CAP=500
