# Preview Environment Variables for @bodywise/web (Vercel Preview / Pull Requests)
# Configure these in Vercel Dashboard -> Project Settings -> Environment Variables (Target: Preview)

NEXT_PUBLIC_APP_ENV=preview
# In preview environments, you can point to a staging Render API instance,
# or point to your production Render API (ensure preview URLs are listed in Render CORS_ORIGINS).
NEXT_PUBLIC_API_URL=https://bodywise-match-api-staging.onrender.com
