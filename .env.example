# ==============================================================================
# Environment Variables for Bodywise Match Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Frontend (apps/web - Vercel)
# ------------------------------------------------------------------------------
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# Vercel Production Environment:
# NEXT_PUBLIC_API_URL=https://bodywise-match-api.onrender.com
# NEXT_PUBLIC_APP_ENV=production

# Vercel Preview / Staging Environment:
# NEXT_PUBLIC_API_URL=https://bodywise-match-api-staging.onrender.com
# NEXT_PUBLIC_APP_ENV=preview

# ------------------------------------------------------------------------------
# 2. REST API (apps/api - Render)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://bodywise-match.vercel.app,https://bodywise-match-preview.vercel.app
RATE_LIMIT=100

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database (Render & Migrations)
# ------------------------------------------------------------------------------
# IMPORTANT: Render containers and Vercel serverless apps MUST use the
# POOLED connection string on port 6543 (?pgbouncer=true or Supavisor pooler).
# Direct port 5432 will exhaust max connections during traffic spikes.
#
# Pooled (Port 6543) - REQUIRED for production Render/Vercel:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (Port 5432) - Only for CLI migrations if transaction pooler is disabled:
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. Optional Groq LLM Intent Parser (Replaces Strategy B in /v1/match/parse)
# ------------------------------------------------------------------------------
# In production, set these in Render Dashboard (never commit real keys).
# If GROQ_API_KEY is unset or LLM_ENABLED=false, the app automatically uses
# the deterministic TypeScript rules parser with zero external dependencies.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
LLM_ENABLED=true
LLM_TIMEOUT_MS=8000
LLM_MAX_INPUT_CHARS=1500
LLM_DAILY_CAP=500
ENABLE_LLM_REWRITE=false
